# ── Solana ────────────────────────────────────────────────────────────────────
SOLANA_CLUSTER=localnet
# Нетиповий порт навмисно: на 8899 може працювати локальна мережа іншого
# проекту, і тоді ми мовчки читаємо чужий стан замість свого.
SOLANA_RPC_URL=http://127.0.0.1:8909
GENOVAULT_PROGRAM_ID=9G5ri75FHhrD5V4ujTwvmv5ULCSRTcu4x4mvzKk6tNEb

# Мінт розрахункової одиниці. Конфіденційне розширення вмикається при створенні
# мінта, тому це власний тестовий мінт, а не USDC — у справжнього USDC такого
# розширення немає.
SETTLEMENT_MINT=

# ── Arcium ────────────────────────────────────────────────────────────────────
# Локальний MPC-кластер. Зовнішній кластер тут не потрібен і не використовується.
# Порт навмисно не 8080: він часто зайнятий стороннім софтом, а бінд на 0.0.0.0
# маскує конфлікт — сервіс «слухається», але localhost віддає чужу відповідь.
ARCIUM_CLUSTER_URL=http://127.0.0.1:8878
ARCIUM_CLUSTER_OFFSET=

# ── База даних ────────────────────────────────────────────────────────────────
# DDL — через session pooler (5432 напряму лише IPv6), рантайм — через 6543.
# Роль postgres, не anon.
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:5432/postgres
DATABASE_POOL_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres

# ── Сховище шифротексту ───────────────────────────────────────────────────────
# Лежить ВИКЛЮЧНО шифротекст. Ключ шифрування сюди не потрапляє ніколи.
STORAGE_DRIVER=fs
STORAGE_FS_ROOT=./fixtures/generated/storage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_BUCKET=datasets

# ── Автентифікація ────────────────────────────────────────────────────────────
# Privy тримає ключ ВХОДУ. Ключ шифрування датасету деривується в браузері
# і сюди не потрапляє (FR-023a).
#
# Секрету застосунку тут навмисно немає: API лише звіряє підпис сесійного
# токена, а серверний ключ Privy відкрив би ще й читання профілю з гаманцями.
PRIVY_APP_ID=
VITE_PRIVY_APP_ID=

# Публічний ключ перевірки з панелі Privy (PEM). Порожній рядок означає
# «беремо ключі з JWKS» — тоді ротація на боці провайдера не ламає вхід.
PRIVY_VERIFICATION_KEY=
# Перевизначення JWKS-точки; типово — https://auth.privy.io/api/v1/apps/<id>/jwks.json
PRIVY_JWKS_URL=

# ── API ───────────────────────────────────────────────────────────────────────
API_PORT=8879
API_BASE_URL=http://127.0.0.1:8879
LOG_LEVEL=info

# ── Платформа ─────────────────────────────────────────────────────────────────
PLATFORM_FEE_BPS=700
