{
  "criterion": "SC-004",
  "note": "Twenty consent scenarios, ten allowed and ten refused. Every label is written from the owner's intent in words, not computed by any code in this repository: a label derived from checkConsent or Consent::check would only prove that the code agrees with itself. `reason` is the constraint a refusal must name (FR-008), in the vocabulary of packages/shared CONSENT_VIOLATIONS. Every dataset in a scenario is its own: no two scenarios share a consent, so one scenario cannot pass on another's setup. `expiresInSeconds` is counted from the chain clock at the moment the consent is written; `orderAfterDeadline` makes the order wait until the chain clock has passed every deadline written in the scenario.",
  "scenarios": [
    {
      "id": "exact-match",
      "label": "allowed",
      "reason": null,
      "intent": "The owner allows oncology research by academic buyers. An academic buyer orders oncology.",
      "pool": [
        {
          "dataset": "sc004-exact",
          "history": [
            { "consent": { "allowed": ["oncology"], "forbidden": [], "categories": ["academic"] } }
          ]
        }
      ],
      "order": { "useType": "oncology", "buyerCategory": "academic" }
    },
    {
      "id": "one-of-several-uses",
      "label": "allowed",
      "reason": null,
      "intent": "The owner allows oncology, cardiology and rare disease research by academics. An academic buyer orders cardiology.",
      "pool": [
        {
          "dataset": "sc004-several-uses",
          "history": [
            {
              "consent": {
                "allowed": ["oncology", "cardiology", "rareDisease"],
                "forbidden": [],
                "categories": ["academic"]
              }
            }
          ]
        }
      ],
      "order": { "useType": "cardiology", "buyerCategory": "academic" }
    },
    {
      "id": "everything-but-pharma",
      "label": "allowed",
      "reason": null,
      "intent": "The owner allows every use to every buyer except commercial pharma. A commercial buyer orders rare disease research.",
      "pool": [
        {
          "dataset": "sc004-all-but-pharma",
          "history": [
            {
              "consent": {
                "allowed": [
                  "oncology",
                  "cardiology",
                  "rareDisease",
                  "populationGenetics",
                  "pharmaCommercial"
                ],
                "forbidden": ["pharmaCommercial"],
                "categories": ["academic", "nonProfit", "commercial", "government"]
              }
            }
          ]
        }
      ],
      "order": { "useType": "rareDisease", "buyerCategory": "commercial" }
    },
    {
      "id": "before-the-deadline",
      "label": "allowed",
      "reason": null,
      "intent": "The owner allows population genetics to academics for one hour. An academic buyer orders it inside that hour.",
      "pool": [
        {
          "dataset": "sc004-before-deadline",
          "history": [
            {
              "consent": {
                "allowed": ["populationGenetics"],
                "forbidden": [],
                "categories": ["academic"],
                "expiresInSeconds": 3600
              }
            }
          ]
        }
      ],
      "order": { "useType": "populationGenetics", "buyerCategory": "academic" }
    },
    {
      "id": "one-of-several-categories",
      "label": "allowed",
      "reason": null,
      "intent": "The owner allows oncology to academic and non-profit buyers. A non-profit buyer orders oncology.",
      "pool": [
        {
          "dataset": "sc004-several-categories",
          "history": [
            {
              "consent": {
                "allowed": ["oncology"],
                "forbidden": [],
                "categories": ["academic", "nonProfit"]
              }
            }
          ]
        }
      ],
      "order": { "useType": "oncology", "buyerCategory": "nonProfit" }
    },
    {
      "id": "consent-given-again-after-revocation",
      "label": "allowed",
      "reason": null,
      "intent": "The owner revoked consent, then gave it again on the same terms. An academic buyer orders oncology after that.",
      "pool": [
        {
          "dataset": "sc004-given-again",
          "history": [
            { "consent": { "allowed": ["oncology"], "forbidden": [], "categories": ["academic"] } },
