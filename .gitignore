# Без слеша в кінці навмисно: target і .anchor — це симлінки на теки у файловій
# системі WSL (див. scripts/wsl-dirs.sh), а правило зі слешем збігається лише з
# теками й симлінк пропускає. Тоді в репозиторій потрапляє посилання з
# абсолютним шляхом чужої машини.
/target
/.anchor

.env
.env.*
!.env.example

.anchor/
test-ledger/
.arcium/

# Ключі. Програмний keypair теж: він дає право задеплоїти під той самий адрес.
id.json
*-keypair.json
*.keypair.json
*.pem

# Артефакти локальної мережі Arcium: ключі вузлів, конфіги кластера, акаунти
# генезису. Створюються заново при кожному `arcium localnet` і містять
# приватні ключі ARX-вузлів у відкритому вигляді.
artifacts/

# Шифротекст і згенеровані датасети в репо не потрапляють: навіть синтетичні
# геномні фікстури важать десятки мегабайт і відтворюються генератором.
fixtures/generated/


*.md
!README.md

.DS_Store
